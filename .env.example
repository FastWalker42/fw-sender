# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789

# Bot username (without @) — needed for tgwidget deep links
BOT_USERNAME=your_bot_username

# Timezone
TZ=Europe/Moscow

# MTProto API credentials (from https://my.telegram.org/apps)
API_ID=
API_HASH=
